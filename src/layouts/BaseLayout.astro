---
import '../styles/global.css';
import Header from '../components/Header.astro';
import {
  BUSINESS_NAME,
  CONTACT_ADDRESS_LINE,
  CONTACT_CITY,
  CONTACT_COUNTRY,
  CONTACT_EMAIL,
  CONTACT_LAT,
  CONTACT_LON,
  CONTACT_MAX_URL,
  CONTACT_PHONE_DISPLAY,
  CONTACT_PHONE_E164,
  CONTACT_TELEGRAM_URL,
  CONTACT_STREET,
  CONTACT_WHATSAPP_URL,
  CONTACT_YANDEX_MAP_URL,
  GOOGLE_SITE_VERIFICATION,
  YANDEX_VERIFICATION
} from '../consts/site';
import ryba from '../data/catalog/ryba.json';

const {
  title,
  description,
  hero = false,
  flushBottom = false,
  ogImagePath = '/images/blog/open-10.webp',
  ogType = 'website'
} = Astro.props;
const mainClass = `px-6 ${flushBottom ? 'pb-0' : 'pb-10'} ${
  hero ? 'pt-0' : 'pt-32 md:pt-36 lg:pt-40'
}`;
const site = Astro.site;
const pagePath = Astro.url?.pathname ?? '/';
const normalizedPath = pagePath === '/' ? '/' : pagePath.endsWith('/') ? pagePath : `${pagePath}/`;
const pageUrl = site ? new URL(normalizedPath, site).toString() : null;
const ogImage = site ? new URL(ogImagePath, site).toString() : ogImagePath;
const siteRoot = site ? new URL('/', site).toString() : 'https://rybasvprud.ru/';
const logoUrl = site ? new URL('/fish.svg', site).toString() : '/fish.svg';
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'LocalBusiness'],
  '@id': `${siteRoot}#organization`,
  name: BUSINESS_NAME,
  url: siteRoot,
  logo: logoUrl,
  image: logoUrl,
  email: CONTACT_EMAIL,
  telephone: CONTACT_PHONE_E164,
  address: {
    '@type': 'PostalAddress',
    addressLocality: CONTACT_CITY,
    streetAddress: CONTACT_STREET,
    addressCountry: CONTACT_COUNTRY
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: CONTACT_LAT,
    longitude: CONTACT_LON
  },
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      telephone: CONTACT_PHONE_E164,
      email: CONTACT_EMAIL,
      areaServed: 'RU',
      availableLanguage: ['ru']
    }
  ],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: [
        'Monday',
        'Tuesday',
        'Wednesday',
        'Thursday',
        'Friday',
        'Saturday',
        'Sunday'
      ],
      opens: '00:00',
      closes: '23:59'
    }
  ],
  sameAs: [CONTACT_YANDEX_MAP_URL, CONTACT_WHATSAPP_URL, CONTACT_MAX_URL]
};
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico?v=20260421" sizes="any" />
    <link rel="icon" type="image/png" href="/images/ava.png?v=20260421" />
    <link rel="shortcut icon" type="image/png" href="/images/ava.png?v=20260421" />
    <link rel="apple-touch-icon" href="/images/ava.png?v=20260421" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/montserrat-cyrillic.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/montserrat-latin.woff2" crossorigin />
    <title>{title}</title>
    {description ? <meta name="description" content={description} /> : null}
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Рыба здесь - есть!" />
    <meta property="og:title" content={title} />
    {description ? <meta property="og:description" content={description} /> : null}
    {pageUrl ? <meta property="og:url" content={pageUrl} /> : null}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description ? <meta name="twitter:description" content={description} /> : null}
    <meta name="twitter:image" content={ogImage} />
    <meta name="yandex-verification" content={YANDEX_VERIFICATION} />
    <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    <slot name="head" />
    <!-- Yandex.Metrika counter -->
    <script is:inline type="text/javascript">
      (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();for(var j=0;j<document.scripts.length;j++){if(document.scripts[j].src===r){return;}}k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window,document,'script','https://mc.yandex.ru/metrika/tag.js?id=108985083','ym');
      ym(108985083,'init',{webvisor:true,clickmap:true,ecommerce:"dataLayer",accurateTrackBounce:true,trackLinks:true});
    </script>
    <noscript><div><img src="https://mc.yandex.ru/watch/108985083" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
    <!-- /Yandex.Metrika counter -->
  </head>
  <body class="min-h-screen bg-sky-50 pb-20 md:pb-0">
    <Header />
    <slot name="hero" />
    <main class={mainClass}>
      <slot />
    </main>
    <!-- Floating contact carousel -->
    <div class="fixed bottom-5 right-4 z-[60] md:bottom-6 md:right-6" style="width:3.5rem;height:3.5rem;">
      <button
        data-float-btn
        data-widget-trigger
        aria-label="Связаться с нами"
        class="float-contact-btn float-contact-btn--active"
        style="background:linear-gradient(135deg,#0ea5b7,#155e75)"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 4h4l2.2 5-2.2 1.2c1.7 3.3 4.1 5.7 7.4 7.4l1.2-2.2 5 2.2v4c-9.4 0-17-7.6-17-17Z" />
        </svg>
      </button>
      <button
        data-float-btn
        data-widget-trigger
        aria-label="Связаться с нами"
        class="float-contact-btn"
        style="background:linear-gradient(135deg,#38bdf8,#0284c7)"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.7 4.2 3.8 10.8c-.8.3-.7 1.5.1 1.7l4.4 1.4 1.6 4.8c.2.7 1.1.8 1.5.3l2.6-3.3 4.3 3.1c.6.4 1.4.1 1.6-.6l2.3-12.4c.1-.9-.8-1.7-1.5-1.3Z" fill="currentColor"/>
        </svg>
      </button>
      <button
        data-float-btn
        data-widget-trigger
        aria-label="Связаться с нами"
        class="float-contact-btn"
        style="background:linear-gradient(135deg,#25d366,#128c7e)"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
          <path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.985-1.407A9.953 9.953 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18a7.946 7.946 0 0 1-4.274-1.243l-.306-.183-3.167.894.878-3.082-.2-.316A7.946 7.946 0 0 1 4 12c0-4.411 3.589-8 8-8s8 3.589 8 8-3.589 8-8 8z"/>
        </svg>
      </button>
    </div>

    <!-- Backdrop — mobile only -->
    <div id="contact-backdrop" style="display:none;position:fixed;inset:0;z-index:65;background:rgba(0,0,0,0.45);backdrop-filter:blur(2px);"></div>

    <!-- Contact widget — bottom sheet on mobile, popup card on desktop -->
    <div id="contact-widget" role="dialog" aria-modal="true" aria-label="Контакты"
      style="display:none;position:fixed;z-index:70;">
      <div id="contact-widget-inner" style="background:#fff;padding:1rem 1.2rem 2.2rem;box-shadow:0 -8px 40px rgba(15,10,5,0.13);">
        <!-- Handle (mobile only, hidden on desktop via CSS) -->
        <div class="widget-handle" style="width:36px;height:4px;background:#e2e8f0;border-radius:2px;margin:0 auto 1.2rem;"></div>
        <!-- Close -->
        <button id="contact-widget-close" aria-label="Закрыть"
          style="position:absolute;top:1.1rem;right:1.2rem;background:#f1f5f9;border:none;cursor:pointer;color:#64748b;width:2rem;height:2rem;border-radius:50%;font-size:0.85rem;display:flex;align-items:center;justify-content:center;line-height:1;">✕</button>
        <!-- Title -->
        <p style="text-align:center;color:#0b1f2a;font-size:1.05rem;font-weight:700;margin:0 0 0.2rem;">Напишите нам</p>
        <p style="text-align:center;color:#64748b;font-size:0.75rem;margin:0 0 1.2rem;">Ответим в ближайшее время</p>
        <!-- Messenger buttons -->
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:0.65rem;margin-bottom:0.9rem;">
          <a href={CONTACT_WHATSAPP_URL} target="_blank" rel="noreferrer noopener"
            style="display:flex;flex-direction:column;align-items:center;gap:0.5rem;padding:1rem 0.4rem;border-radius:16px;background:linear-gradient(145deg,#25d366,#128c7e);color:#fff;text-decoration:none;font-size:0.72rem;font-weight:700;box-shadow:0 6px 16px rgba(37,211,102,0.3);">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
              <path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.985-1.407A9.953 9.953 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18a7.946 7.946 0 0 1-4.274-1.243l-.306-.183-3.167.894.878-3.082-.2-.316A7.946 7.946 0 0 1 4 12c0-4.411 3.589-8 8-8s8 3.589 8 8-3.589 8-8 8z"/>
            </svg>
            WhatsApp
          </a>
          <a href={CONTACT_TELEGRAM_URL} target="_blank" rel="noreferrer noopener"
            style="display:flex;flex-direction:column;align-items:center;gap:0.5rem;padding:1rem 0.4rem;border-radius:16px;background:linear-gradient(145deg,#38bdf8,#0284c7);color:#fff;text-decoration:none;font-size:0.72rem;font-weight:700;box-shadow:0 6px 16px rgba(56,189,248,0.3);">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.7 4.2 3.8 10.8c-.8.3-.7 1.5.1 1.7l4.4 1.4 1.6 4.8c.2.7 1.1.8 1.5.3l2.6-3.3 4.3 3.1c.6.4 1.4.1 1.6-.6l2.3-12.4c.1-.9-.8-1.7-1.5-1.3Z"/>
            </svg>
            Telegram
          </a>
          <a href={CONTACT_MAX_URL} target="_blank" rel="noreferrer noopener"
            style="display:flex;flex-direction:column;align-items:center;gap:0.5rem;padding:1rem 0.4rem;border-radius:16px;background:linear-gradient(145deg,#7c5cfc,#4a2daa);color:#fff;text-decoration:none;font-size:0.72rem;font-weight:700;box-shadow:0 6px 16px rgba(124,92,252,0.3);">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" aria-hidden="true">
              <path d="M14.254 3.28a4.301 4.301 0 0 1 4.3 4.302 4.301 4.301 0 0 1-1.993 3.63 6.085 6.085 0 0 1 1.054 3.422 6.085 6.085 0 0 1-6.085 6.085 6.085 6.085 0 0 1-6.085-6.085 6.085 6.085 0 0 1 4.66-5.916 4.301 4.301 0 0 1-.152-1.136 4.301 4.301 0 0 1 4.301-4.301zm0 1.849a2.453 2.453 0 0 0-2.453 2.453 2.453 2.453 0 0 0 2.453 2.453 2.453 2.453 0 0 0 2.453-2.453 2.453 2.453 0 0 0-2.453-2.453zm-2.724 5.268a4.237 4.237 0 0 0-4.237 4.237 4.237 4.237 0 0 0 4.237 4.237 4.237 4.237 0 0 0 4.237-4.237 4.237 4.237 0 0 0-4.237-4.237zm.032 2.54a1.781 1.781 0 1 1 0 3.562 1.781 1.781 0 0 1 0-3.562Z"/>
            </svg>
            MAX
          </a>
        </div>
        <!-- Phone -->
        <a href={`tel:${CONTACT_PHONE_E164}`}
          style="display:flex;align-items:center;justify-content:space-between;gap:0.75rem;background:#f0f9ff;border:1px solid #bae6fd;border-radius:14px;padding:0.75rem 1rem;text-decoration:none;">
          <div>
            <p style="color:#0b1f2a;font-size:0.7rem;font-weight:600;margin:0 0 1px;">Предпочитаете звонить?</p>
            <p style="color:#0ea5b7;font-size:0.88rem;font-weight:700;margin:0;white-space:nowrap;">{CONTACT_PHONE_DISPLAY}</p>
          </div>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0ea5b7" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0;">
            <path d="M5 4h4l2.2 5-2.2 1.2c1.7 3.3 4.1 5.7 7.4 7.4l1.2-2.2 5 2.2v4c-9.4 0-17-7.6-17-17Z"/>
          </svg>
        </a>
      </div>
    </div>

    <style>
      .float-contact-btn {
        position: absolute;
        inset: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9999px;
        color: #fff;
        border: none;
        cursor: pointer;
        box-shadow: 0 8px 24px rgba(0,0,0,0.25);
        opacity: 0;
        transform: scale(0.7) rotate(-30deg);
        transition: opacity 0.35s ease, transform 0.35s ease;
        pointer-events: none;
      }
      .float-contact-btn svg { width: 1.5rem; height: 1.5rem; }
      .float-contact-btn--active {
        opacity: 1;
        transform: scale(1) rotate(0deg);
        pointer-events: auto;
      }
      .float-contact-btn:hover {
        filter: brightness(1.1);
        transform: scale(1.08) rotate(0deg) !important;
      }
      /* Mobile: full-width bottom sheet */
      #contact-widget {
        bottom: 0; left: 0; right: 0;
        transition: transform 0.3s cubic-bezier(0.32,0.72,0,1);
        transform: translateY(100%);
      }
      #contact-widget-inner { border-radius: 24px 24px 0 0; }
      #contact-widget.widget-visible { transform: translateY(0); }
      #contact-backdrop { transition: opacity 0.3s ease; opacity: 0; }
      #contact-backdrop.backdrop-visible { opacity: 1; }

      /* Desktop: small popup card above the button */
      @media (min-width: 768px) {
        #contact-widget {
          bottom: 5rem; right: 1.5rem;
          left: auto; width: 280px;
          transform: scale(0.92) translateY(8px);
          transform-origin: bottom right;
          transition: opacity 0.2s ease, transform 0.2s ease;
          opacity: 0;
        }
        #contact-widget-inner { border-radius: 20px; padding-bottom: 1.2rem; box-shadow: 0 8px 40px rgba(15,10,5,0.16); }
        #contact-widget.widget-visible {
          transform: scale(1) translateY(0);
          opacity: 1;
        }
        .widget-handle { display: none; }
        #contact-backdrop { display: none !important; }
      }
    </style>
    <script is:inline>
      (function () {
        // Carousel
        var btns = document.querySelectorAll('[data-float-btn]');
        var current = 0;
        var intervals = [4000, 3000, 3000];
        function next() {
          btns[current].classList.remove('float-contact-btn--active');
          current = (current + 1) % btns.length;
          btns[current].classList.add('float-contact-btn--active');
          setTimeout(next, intervals[current]);
        }
        setTimeout(next, intervals[0]);

        // Widget toggle
        var widget = document.getElementById('contact-widget');
        var backdrop = document.getElementById('contact-backdrop');
        var closeBtn = document.getElementById('contact-widget-close');
        var isDesktop = function () { return window.innerWidth >= 768; };
        function openWidget() {
          widget.style.display = 'block';
          if (!isDesktop()) {
            backdrop.style.display = 'block';
            setTimeout(function () { backdrop.classList.add('backdrop-visible'); }, 10);
          }
          setTimeout(function () { widget.classList.add('widget-visible'); }, 10);
        }
        function closeWidget() {
          widget.classList.remove('widget-visible');
          backdrop.classList.remove('backdrop-visible');
          var delay = isDesktop() ? 220 : 320;
          setTimeout(function () { widget.style.display = 'none'; backdrop.style.display = 'none'; }, delay);
        }
        document.querySelectorAll('[data-widget-trigger]').forEach(function (btn) {
          btn.addEventListener('click', function (e) { e.stopPropagation(); openWidget(); });
        });
        closeBtn.addEventListener('click', closeWidget);
        document.addEventListener('click', function (e) {
          if (widget.style.display !== 'none' && !widget.contains(e.target)) closeWidget();
        });
      })();
    </script>
    <footer class="border-t border-white/10 bg-[#0b1f2a] text-white">
      <div class="mx-auto max-w-6xl px-6 py-12">
        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
          <div>
            <a class="logo-tagline inline-flex text-xl leading-none text-white" href="/">
              Рыба здесь - есть<span class="logo-excl">!</span>
            </a>
            <p class="mt-3 text-sm text-white/70">
              Рыба для зарыбления: мальки и взрослые особи для дачных прудов, озёр и водоёмов.
            </p>
          </div>

          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.3em] text-white/60">Каталог</p>
            <ul class="mt-4 grid gap-2 text-sm text-white/70">
              {ryba.categories.map((category) => (
                <li>
                  <a class="transition hover:text-white" href={`/ryba/${category.slug}/`}>
                    {category.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.3em] text-white/60">Компания</p>
            <ul class="mt-4 grid gap-2 text-sm text-white/70">
              <li>
                <a class="transition hover:text-white" href="/blog/">Блог</a>
              </li>
              <li>
                <a class="transition hover:text-white" href="/contacts/">Контакты</a>
              </li>
              <li>
                <a class="transition hover:text-white" href="/privacy/">Политика конфиденциальности</a>
              </li>
            </ul>
          </div>

          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.3em] text-white/60">Контакты</p>
            <ul class="mt-4 grid gap-2 text-sm text-white/70">
              <li>
                <a
                  class="transition hover:text-white"
                  href={CONTACT_YANDEX_MAP_URL}
                  target="_blank"
                  rel="noreferrer"
                >
                  {CONTACT_ADDRESS_LINE}
                </a>
              </li>
              <li>
                <a class="transition hover:text-white" href={`tel:${CONTACT_PHONE_E164}`}>
                  {CONTACT_PHONE_DISPLAY}
                </a>
              </li>
              <li>
                <a class="transition hover:text-white" href={`mailto:${CONTACT_EMAIL}`}>
                  {CONTACT_EMAIL}
                </a>
              </li>
              <li>Ежедневно 24/7</li>
            </ul>
          </div>
        </div>
      </div>
      <div class="border-t border-white/10">
        <div class="mx-auto max-w-6xl px-6 py-5 text-xs text-white/50"></div>
      </div>
    </footer>
  </body>
</html>
